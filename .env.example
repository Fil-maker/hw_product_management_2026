# Скопируйте в .env (делается автоматически в `make setup`) и при необходимости поменяйте.

# Учётные данные S3 (RustFS). Ими же инициализируется сервер в docker compose.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin-secret

# Бакет, который создаётся автоматически при `make s3-up`.
S3_BUCKET=datasets

# Порты хранилища на хосте: S3 API и веб-консоль.
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Адрес S3 API для кода на хосте. Должен совпадать с S3_PORT.
S3_ENDPOINT_URL=http://localhost:9000

# Бакет для артефактов MLflow (модели, графики); создаётся автоматически при `make infra-up`.
MLFLOW_BUCKET=mlflow

# База метаданных MLflow (PostgreSQL в контейнере, наружу не публикуется).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow-secret
POSTGRES_DB=mlflow

# Порт интерфейса MLflow на хосте: http://localhost:5000
MLFLOW_PORT=5000
